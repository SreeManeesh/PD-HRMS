# ─── Required ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://hrms_user:strongpassword@localhost:5432/hrms_db

JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string-before-production
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string-for-refresh

# ─── Optional (defaults shown) ─────────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# App / asset URLs (used in CSP headers and email links)
APP_URL=http://localhost:5173
CANDIDATE_PORTAL_URL=http://localhost:5173/candidate/offer
# Optional: set to your CDN/S3 host if serving uploads from a different origin
# ASSET_HOST=https://assets.yourcompany.com

# ─── SMTP (leave empty to disable email) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Proteccio HRMS
SMTP_FROM_EMAIL=

# ─── Employee Registration Wizard microservice ─────────────────────────────────
WIZARD_API_URL=http://localhost:4100
WIZARD_URL=http://localhost:5174
WIZARD_SERVICE_SECRET=
