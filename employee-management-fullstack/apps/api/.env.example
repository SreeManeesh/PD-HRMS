PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hrms
JWT_SECRET=replace-this-in-production
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# When true, the standalone wizard app can mint a session without a token.
# Use for dev/demo only — keep OFF (default) in production.
ALLOW_ANONYMOUS_WIZARD=false
